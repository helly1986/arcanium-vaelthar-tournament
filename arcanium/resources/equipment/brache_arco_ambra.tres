script = ExtResource("1")
lore = "Brache da strada dell'Ordine, lino pesante e cuoio dove serve, tagliate per stare in sella tutto il giorno senza pensarci. Chi le porta con la Veste viene scambiato per un funzionario dell'Arco d'Ambra, e passa. Chi le porta da sole viene scambiato per un carrettiere, e passa lo stesso."
