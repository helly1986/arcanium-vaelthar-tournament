[ext_resource type="Script" path="res://arcanium/resources/campione_resource.gd" id="1_campione"]

[resource]
script = ExtResource("1_campione")
casata = "aethon"
nome = "Zarine Tahvi"
epiteto = "the Question"
genere = "female"
bio = "Twenty-five, raised among the Tari of the Academy of Tahphir, then sworn to the Huti. One day she asked the Atesh aloud the question no one asks: why is the Asron's seat empty? Two weeks later she was named champion of the Tournament, an honour that is an exile. Serene, smiling, and she never lies."
battuta = "Asari."
bio_casata = "The oldest faith of Vaelthar worshipped a light and a shadow long before the Wanderer came. Arcanium, they say, is a force that contains its opposite. The Asron's seat has been empty since the Fourth Era began, and the Circle of the Atesh changes the subject whenever anyone asks why."
territorio = "Davrath — the Plains of Judgement"
kit = PackedStringArray("Sigil", "Counterweight Staff")
affinita = "SACRO"
abilita_nome = "Asari"
abilita_testo = "Choose the version with each use. A short press, Light: a holy wave that wounds enemies and heals her a little. Hold, Shadow: a stronger wave that costs her health. Repeating the same version makes it stronger: that is karma."
corpo = "res://assets/characters/campioni/zarine/zarine_arp.glb"
stoffa = {"capsule": {"LowerLeg": 0.085, "UpperLeg": 0.06}, "rilievo": 0.018, "viaggio": 0.03}
dotazione = {"arma_primaria": "res://arcanium/resources/weapons/asta_contrappeso.tres", "arma_secondaria": "res://arcanium/resources/equipment/sigillo_aethon.tres"}
prese = { "BOW": { "chiusura_mano_destra": 0.75, "chiusura_mano_sinistra": 0.0, "pollice_mano_destra": -0.5, "pollice_mano_sinistra": 1.0, "presa_arma": Transform3D(0.81951237, 0.3052283, 0.48501092, 0.089706555, 0.7675879, -0.63463473, -0.5659965, 0.5635999, 0.60166615, -0.09409851, 0.0077416413, 0.0026991442), "seconda_mano": Transform3D(-0.9723717, 0.12305306, -0.19837093, -0.12305671, 0.4519191, 0.88353056, 0.19836873, 0.8835311, -0.42429066, -0.21961224, -0.087294936, 0.14052135), "seconda_mano_attiva": false } }
pollice_mano_sinistra = -0.3
