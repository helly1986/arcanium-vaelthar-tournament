[gd_resource type="Resource" script_class="CampioneResource" load_steps=2 format=3]

[ext_resource type="Script" path="res://arcanium/resources/campione_resource.gd" id="1_campione"]

[resource]
script = ExtResource("1_campione")
casata = "sylvorn"
nome = "Ilwen Thessar"
epiteto = "the Deaf"
genere = "female"
bio = "Born in Thessil, the most fortified border city of Kalvorn. Raised to command, she was never given the Listening Horn: she will never hear the spirits. A born leader, direct and generous with her own, quietly envious of those who listen. Sylvorn sends her because she wins, not because she hears."
battuta = "I hear enough."
bio_casata = "The forest House believes Arcanium belongs to no one: it can be listened to, never owned. Their archmages don't cast; they ask the spirits to act. Three hereditary governors meet twice a year, but true power lies with the Keepers of the Forest, who are not elected. They manifest."
territorio = "Kalvorn — the Perpetual Forest"
kit = PackedStringArray("Sigil", "Sylvorn Spirit Bow")
affinita = "PERFORAZIONE"
abilita_nome = "The Unasked Echo"
abilita_testo = "Every third hit, a spectral echo repeats her last shot on the same target. The spirits help her without her hearing them. It isn't a summon: it's the shot coming back."
corpo = "res://assets/characters/campioni/ilwen/ilwen_arp.glb"
dotazione = {"arma_primaria": "res://arcanium/resources/weapons/arco_di_spirito_sylvorn.tres", "arma_secondaria": "res://arcanium/resources/equipment/sigillo_sylvorn.tres"}
prese = { "HEAVY": { "chiusura_mano_destra": 0.55, "chiusura_mano_sinistra": 0.9, "pollice_mano_destra": 0.1, "pollice_mano_sinistra": -0.3, "presa_arma": Transform3D(-0.8953606, 0.1903378, 0.40261662, 0.17533037, 0.9817089, -0.074194774, -0.4093746, 0.0041594952, -0.91235626, -0.06647094, -0.0040569305, 0.042224735), "seconda_mano": Transform3D(-0.9138196, 0.13645762, -0.38250875, -0.13645557, 0.7839371, 0.60565925, 0.38250908, 0.6056585, -0.69775647, -0.20686078, -0.030332819, 0.1724871), "seconda_mano_attiva": true } }
pollice_mano_sinistra = 1.0
pollice_mano_destra = -0.5
chiusura_mano_sinistra = 0.0
chiusura_mano_destra = 0.75
presa_arma = Transform3D(0.91559076, 0.2919077, 0.27655673, -0.04938435, 0.76418376, -0.6431048, -0.399067, 0.57516366, 0.7140948, -0.079835124, 0.02009213, -0.025417574)
