[ext_resource type="Script" path="res://arcanium/resources/campione_resource.gd" id="1_campione"]

[resource]
script = ExtResource("1_campione")
casata = "amareth"
nome = "Rashan Dumari"
epiteto = "the Sunset Runaway"
genere = "male"
bio = "Twenty-eight, the most charming of the six: quick, laughing, a born storyteller, a little vain. He lives in the moment, as the cycle of Amareth teaches. His clan has just won the Sunset Gathering and he is due to become Keth-Amar, the one office nobody wants. The Tournament is the perfect excuse to stay away: the further he goes, the later he gets home."
battuta = "Let's make it quick."
bio_casata = "The desert House was the first to meet the Wanderer, or the last. They learned not to take Arcanium but to follow it: it breathes, with a dawn and a sunset like the sun. Nomad clans of no more than thirty families cross Kalath-Dun by the stars, and meet every seven years to choose the Keth-Amar."
territorio = "Kalath-Dun — the Sea of Sand"
kit = PackedStringArray("Sigil", "Curved Blade of Kalath-Dun")
affinita = "FULMINE"
abilita_nome = "Sunset Hour"
abilita_testo = "Slows time across the whole arena except for him: three seconds, rising to six when his health is below a quarter. He is at his best on the edge."
corpo = "res://assets/characters/campioni/rashan/rashan_arp.glb"
idle = "res://assets/characters/campioni/rashan/rashan_idle.glb"
presa_arma = Transform3D(0.9384504, -0.14995769, -0.31116626, 0.121077195, 0.9865028, -0.11025593, 0.32349995, 0.065794215, 0.9439387, -0.07115531, -0.012994885, 0.05514946)
chiusura_mano_destra = 0.9
dotazione = {"arma_primaria": "res://arcanium/resources/weapons/lama_ricurva.tres", "arma_secondaria": "res://arcanium/resources/equipment/sigillo_amareth.tres"}
prese = { "BOW": { "chiusura_mano_destra": 0.75, "chiusura_mano_sinistra": 0.0, "pollice_mano_destra": -0.35, "pollice_mano_sinistra": 1.0, "presa_arma": Transform3D(0.84200644, 0.24835047, 0.4789024, 0.06739111, 0.8323547, -0.55013067, -0.5352415, 0.49548757, 0.6841109, -0.10513988, 0.00083371624, -0.01490967), "seconda_mano": Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0, 0), "seconda_mano_attiva": false }, "HEAVY": { "chiusura_mano_destra": 0.55, "chiusura_mano_sinistra": 0.9, "pollice_mano_destra": 0.1, "pollice_mano_sinistra": -0.25, "presa_arma": Transform3D(-0.9619024, -0.055416435, 0.26771548, -0.087770104, 0.9899999, -0.11042889, -0.25891876, -0.1297197, -0.95714825, -0.0632039, -0.015204281, 0.06288589), "seconda_mano": Transform3D(-0.9969662, 0.03478577, -0.06963817, -0.03478446, 0.6012329, 0.7983168, 0.0696384, 0.7983168, -0.5981983, -0.23292315, -0.08953792, 0.11695342), "seconda_mano_attiva": true } }
