[resource]
script = ExtResource("1")
image = ExtResource("2_img")
lore = "Spadone di guarnigione: due mani, e a Kalvorn lo portava chi teneva il varco quando il varco era stretto. Il tiglio sulla croce è lo stesso dell'armatura, il cuoio del ricasso è consumato al centro perché lì la mano ci va davvero — un colpo di questo si accompagna, non si tira. Il filo è mangiato per tutta la lunghezza e mai in un punto solo: ha parato più di quanto abbia colpito. Sul pomo il tondo verde è intatto, come su ogni cosa che la casata ha ferrato."
base_power = 20
secondary_grade = 2
damage_type = "TAGLIO"
name = "Spadone di Guarnigione Sylvorn"
