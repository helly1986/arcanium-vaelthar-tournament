[resource]
script = ExtResource("1")
lore = "I Thurrak usano quattro braccia. Un arco standard è inutile per loro. Questo però è costruito su proporzioni che nessun umano avrebbe pensato di calcolare — come se qualcuno avesse provato a fare l'inverso. Funziona meglio di qualsiasi arco costruito per umani. La ragione è umiliante per i fabbri di Valdris."
icon = "🏹"
